+# limitations under the License.
+
+"""Stateful deployment-time filtering for robot action targets."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from numbers import Real
+
+import numpy as np
+import torch
+
+
+class EMAActionFilter:
+    """Apply an exponential moving average to scalar action targets.
+
+    The filter follows ``filtered = alpha * target + (1 - alpha) * previous``.
+    On the first action after construction or :meth:`reset`, ``previous`` is
+    initialized from the current observation when a matching key is available.
+    This avoids treating zero as the robot's initial pose.
+
+    Exclusions use case-insensitive substring matching, so an exclusion such as
+    ``"gripper"`` also matches an action key such as ``"gripper.pos"``.
+    """
+
+    def __init__(self, alpha: float | None = None, exclude: Sequence[str] = ()) -> None:
+        if alpha is not None and not 0 < alpha <= 1:
+            raise ValueError(f"EMA alpha must be in (0, 1], got {alpha}")
+
+        self.alpha = alpha
+        self.exclude = tuple(value.casefold() for value in exclude)
+        self._previous: dict[str, float] = {}
+
+    @property
+    def enabled(self) -> bool:
+        """Whether filtering is enabled."""
+        return self.alpha is not None
+
+    def reset(self) -> None:
+        """Forget previous targets so the next action starts from the measured pose."""
+        self._previous.clear()
+
+    def apply(
+        self,
+        action: Mapping[str, float],
+        *observations: Mapping[str, object],
+    ) -> dict[str, float]:
+        """Return a filtered copy of ``action``.
+
+        Observation mappings are searched in order when initializing each
+        action key. Missing or non-scalar observations fall back to the first
+        target itself, making the first command a no-op for that key's filter
+        state rather than introducing an arbitrary jump.
+        """
+        alpha = self.alpha
+        if alpha is None:
+            return dict(action)
+
+        filtered: dict[str, float] = {}
+        for key, value in action.items():
+            target = self._as_scalar(value)
+            if target is None:
+                raise TypeError(f"EMA action filtering requires scalar values, got {key}={value!r}")
+
+            if self._is_excluded(key):
+                filtered[key] = target
+                continue
+
+            previous = self._previous.get(key)
+            if previous is None:
+                previous = self._find_observed_value(key, observations)
+            if previous is None:
+                previous = target
+
+            output = alpha * target + (1 - alpha) * previous
+            self._previous[key] = output
+            filtered[key] = output
+
+        return filtered
+
+    def _is_excluded(self, key: str) -> bool:
+        normalized_key = key.casefold()
+        return any(value in normalized_key for value in self.exclude)
+
+    @classmethod
+    def _find_observed_value(
+        cls,
+        key: str,
+        observations: Sequence[Mapping[str, object]],
+    ) -> float | None:
+        for observation in observations:
+            if key in observation and (value := cls._as_scalar(observation[key])) is not None:
+                return value
+        return None
+
+    @staticmethod
+    def _as_scalar(value: object) -> float | None:
+        if isinstance(value, Real):
+            return float(value)
+        if isinstance(value, np.ndarray) and value.size == 1:
+            return float(value.item())
+        if isinstance(value, torch.Tensor) and value.numel() == 1:
+            return float(value.item())
+        return None

