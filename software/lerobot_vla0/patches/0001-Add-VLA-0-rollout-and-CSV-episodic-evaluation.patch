+
+    schedule = load_prompt_schedule(_write_prompt_schedule(tmp_path), start_row=1, num_rows=2)
+
+    assert len(schedule.entries) == 2
+    assert schedule.entries[0].source_row_index == 1
+    assert schedule.entries[0].episode_number == "1"
+    assert schedule.entries[0].task_type == "Counting"
