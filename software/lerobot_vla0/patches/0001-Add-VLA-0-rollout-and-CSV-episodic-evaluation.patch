diff --git a/src/lerobot/rollout/prompt_schedule.py b/src/lerobot/rollout/prompt_schedule.py
new file mode 100644
index 00000000..e72f2159
--- /dev/null
+++ b/src/lerobot/rollout/prompt_schedule.py
@@ -0,0 +1,153 @@
+# Copyright 2025 The HuggingFace Inc. team. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""CSV-backed per-episode prompt schedules for episodic rollouts."""
+
+from __future__ import annotations
+
+import csv
+from dataclasses import dataclass
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class PromptScheduleEntry:
+    """One selected CSV row, with optional operator-facing metadata."""
+
+    source_row_index: int
+    episode_number: str
+    task_type: str
+    condition: str
+    prompt: str
+    scene_description: str
+
+
+@dataclass(frozen=True)
+class PromptSchedule:
+    """A validated, sliced prompt schedule.
+
+    ``entries[dataset_episode_index]`` is deliberately keyed by the number
+    of episodes already saved in the rollout dataset.  A discarded episode
+    therefore reuses the same row, while a resumed dataset continues with
+    the next row automatically.
+    """
+
+    path: Path
+    entries: tuple[PromptScheduleEntry, ...]
+
+    def entry_for_dataset_episode(self, dataset_episode_index: int) -> PromptScheduleEntry:
+        if dataset_episode_index < 0:
+            raise ValueError(f"dataset_episode_index must be >= 0, got {dataset_episode_index}")
+        if dataset_episode_index >= len(self.entries):
+            raise IndexError(
+                f"Prompt schedule '{self.path}' has {len(self.entries)} selected rows, "
+                f"but rollout dataset episode {dataset_episode_index} needs another prompt."
+            )
+        return self.entries[dataset_episode_index]
+
+    def remaining_for_target(self, target_num_episodes: int, existing_num_episodes: int) -> int:
+        """Validate a target-sized run and return how many episodes remain."""
+        if target_num_episodes < 1:
+            raise ValueError(f"target_num_episodes must be >= 1, got {target_num_episodes}")
+        if target_num_episodes > len(self.entries):
+            raise ValueError(
+                f"Requested {target_num_episodes} episodes, but prompt schedule '{self.path}' "
+                f"contains only {len(self.entries)} selected rows."
+            )
+        if existing_num_episodes > target_num_episodes:
+            raise ValueError(
+                f"Rollout dataset already contains {existing_num_episodes} episodes, which exceeds "
+                f"the configured target of {target_num_episodes}."
+            )
+        return target_num_episodes - existing_num_episodes
+
+
+def _require_column(fieldnames: list[str], column: str, label: str) -> None:
+    if column not in fieldnames:
+        raise ValueError(
+            f"Prompt schedule is missing the {label} column '{column}'. "
+            f"Available columns: {fieldnames}"
+        )
+
+
+def load_prompt_schedule(
+    path: str | Path,
+    *,
+    prompt_column: str = "Prompt",
+    scene_column: str = "Scene Description",
+    episode_column: str = "Episode Number",
+    condition_column: str = "Condition",
+    task_column: str = "Task Being Assessed",
+    start_row: int = 0,
+    num_rows: int | None = None,
+) -> PromptSchedule:
+    """Load and validate a CSV prompt schedule.
+
+    ``start_row`` and ``num_rows`` count data rows, not the header.  The
+    ``utf-8-sig`` encoding accepts both ordinary UTF-8 and files with a BOM,
+    which is common for CSVs exported by spreadsheet applications.
+    """
+    schedule_path = Path(path).expanduser()
+    if start_row < 0:
+        raise ValueError(f"start_row must be >= 0, got {start_row}")
+    if num_rows is not None and num_rows < 1:
+        raise ValueError(f"num_rows must be >= 1 when set, got {num_rows}")
+    if not schedule_path.is_file():
+        raise FileNotFoundError(f"Prompt schedule CSV not found: {schedule_path}")
+
+    with schedule_path.open("r", encoding="utf-8-sig", newline="") as csv_file:
+        reader = csv.DictReader(csv_file)
+        if reader.fieldnames is None:
+            raise ValueError(f"Prompt schedule CSV has no header: {schedule_path}")
+        fieldnames = [name.strip() for name in reader.fieldnames]
+        reader.fieldnames = fieldnames
+        _require_column(fieldnames, prompt_column, "prompt")
+        raw_rows = list(reader)
+
+    stop_row = None if num_rows is None else start_row + num_rows
+    selected_rows = raw_rows[start_row:stop_row]
+    if not selected_rows:
+        raise ValueError(
+            f"Prompt schedule selection is empty: start_row={start_row}, num_rows={num_rows}, "
+            f"CSV rows={len(raw_rows)}."
+        )
+    if num_rows is not None and len(selected_rows) != num_rows:
+        raise ValueError(
+            f"Requested {num_rows} prompt rows starting at {start_row}, but only "
+            f"{len(selected_rows)} rows are available."
+        )
+
+    entries: list[PromptScheduleEntry] = []
+    for offset, row in enumerate(selected_rows):
+        source_row_index = start_row + offset
+        prompt = (row.get(prompt_column) or "").strip()
+        if not prompt:
+            # +2 converts a zero-based data-row index to a one-based CSV line
+            # number while accounting for the header.
+            raise ValueError(
+                f"Prompt schedule has an empty prompt in CSV line {source_row_index + 2} "
+                f"(data row {source_row_index})."
+            )
+        entries.append(
+            PromptScheduleEntry(
+                source_row_index=source_row_index,
+                episode_number=(row.get(episode_column) or "").strip(),
+                task_type=(row.get(task_column) or "").strip(),
+                condition=(row.get(condition_column) or "").strip(),
+                prompt=prompt,
+                scene_description=(row.get(scene_column) or "").strip(),
+            )
+        )
+
+    return PromptSchedule(path=schedule_path.resolve(), entries=tuple(entries))
