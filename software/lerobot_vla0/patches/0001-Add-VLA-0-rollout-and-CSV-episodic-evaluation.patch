diff --git a/src/lerobot/policies/vla0/configuration_vla0.py b/src/lerobot/policies/vla0/configuration_vla0.py
new file mode 100644
index 00000000..d5e41675
--- /dev/null
+++ b/src/lerobot/policies/vla0/configuration_vla0.py
@@ -0,0 +1,147 @@
+# Copyright 2026 The HuggingFace Inc. team. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Configuration for VLA-0 inference through its deployment service."""
+
+from dataclasses import dataclass, field
+
+from lerobot.configs.policies import PreTrainedConfig
+from lerobot.configs.types import FeatureType, NormalizationMode, PolicyFeature
+from lerobot.optim import LRSchedulerConfig, OptimizerConfig
+from lerobot.utils.constants import ACTION, OBS_STATE
+
+DEFAULT_VLA0_ACTION_NAMES = [
+    "shoulder_pan.pos",
+    "shoulder_lift.pos",
+    "elbow_flex.pos",
+    "wrist_flex.pos",
+    "wrist_roll.pos",
+    "gripper.pos",
+]
+
+
+@PreTrainedConfig.register_subclass("vla0")
+@dataclass
+class VLA0Config(PreTrainedConfig):
+    """Inference-only adapter for the VLA-0 HTTP deployment service.
+
+    The VLA-0 model remains in its own CUDA environment. LeRobot serializes
+    the current observations, requests an action chunk, and owns the robot
+    control loop and rollout strategy.
+    """
+
+    server_url: str = "http://127.0.0.1:10000"
+    predict_endpoint: str = "/predict_base64"
+    health_endpoint: str = "/health"
+    request_timeout_s: float = 300.0
+    healthcheck_timeout_s: float = 5.0
+    check_server_on_load: bool = True
+
+    camera_keys: list[str] = field(
+        default_factory=lambda: ["observation.images.wrist", "observation.images.middle"]
+    )
+    image_height: int = 480
+    image_width: int = 640
+    action_dim: int = 6
+    n_action_steps: int = 4
+    action_feature_names: list[str] = field(default_factory=lambda: list(DEFAULT_VLA0_ACTION_NAMES))
+
+    # The policy performs only lightweight HTTP serialization locally. Keeping
+    # observations on CPU avoids unnecessary transfers to the service host's GPU.
+    device: str | None = "cpu"
+    use_amp: bool = False
+    normalization_mapping: dict[str, NormalizationMode] = field(
+        default_factory=lambda: {
+            "VISUAL": NormalizationMode.IDENTITY,
+            "STATE": NormalizationMode.IDENTITY,
+            "ACTION": NormalizationMode.IDENTITY,
+        }
+    )
+
+    def __post_init__(self) -> None:
+        super().__post_init__()
+        self.server_url = self.server_url.rstrip("/")
+        self.predict_endpoint = self._normalize_endpoint(self.predict_endpoint, "predict_endpoint")
+        self.health_endpoint = self._normalize_endpoint(self.health_endpoint, "health_endpoint")
+
+        if not self.server_url.startswith(("http://", "https://")):
+            raise ValueError("VLA-0 server_url must start with http:// or https://")
+        if self.request_timeout_s <= 0 or self.healthcheck_timeout_s <= 0:
+            raise ValueError("VLA-0 request timeouts must be positive")
+        if not self.camera_keys or len(set(self.camera_keys)) != len(self.camera_keys):
+            raise ValueError("VLA-0 camera_keys must be a non-empty list of unique feature keys")
+        if self.image_height <= 0 or self.image_width <= 0:
+            raise ValueError("VLA-0 image dimensions must be positive")
+        if self.action_dim <= 0 or self.n_action_steps <= 0:
+            raise ValueError("VLA-0 action_dim and n_action_steps must be positive")
+        if len(self.action_feature_names) != self.action_dim:
+            raise ValueError(
+                "VLA-0 action_feature_names length must match action_dim: "
+                f"{len(self.action_feature_names)} != {self.action_dim}"
+            )
+
+        if not self.input_features:
+            self.input_features = {
+                OBS_STATE: PolicyFeature(type=FeatureType.STATE, shape=(self.action_dim,)),
+                **{
+                    key: PolicyFeature(
+                        type=FeatureType.VISUAL,
+                        shape=(3, self.image_height, self.image_width),
+                    )
+                    for key in self.camera_keys
+                },
+            }
+        if not self.output_features:
+            self.output_features = {ACTION: PolicyFeature(type=FeatureType.ACTION, shape=(self.action_dim,))}
+        self.validate_features()
+
+    @staticmethod
+    def _normalize_endpoint(value: str, field_name: str) -> str:
+        value = value.strip()
+        if not value:
+            raise ValueError(f"VLA-0 {field_name} must not be empty")
+        return value if value.startswith("/") else f"/{value}"
+
+    @property
+    def observation_delta_indices(self) -> None:
+        return None
+
+    @property
+    def action_delta_indices(self) -> list[int]:
+        return list(range(self.n_action_steps))
+
+    @property
+    def reward_delta_indices(self) -> None:
+        return None
+
+    def get_optimizer_preset(self) -> OptimizerConfig:
+        raise NotImplementedError("VLA-0's LeRobot adapter is inference-only")
+
+    def get_scheduler_preset(self) -> LRSchedulerConfig | None:
+        return None
+
+    def validate_features(self) -> None:
+        if self.input_features is None or self.output_features is None:
+            raise ValueError("VLA-0 input_features and output_features must be configured")
+        missing_cameras = [key for key in self.camera_keys if key not in self.input_features]
+        if missing_cameras:
+            raise ValueError(f"VLA-0 input_features are missing camera keys: {missing_cameras}")
+        if OBS_STATE not in self.input_features:
+            raise ValueError(f"VLA-0 input_features must include {OBS_STATE!r}")
+        if ACTION not in self.output_features:
+            raise ValueError(f"VLA-0 output_features must include {ACTION!r}")
+        if self.input_features[OBS_STATE].shape != (self.action_dim,):
+            raise ValueError("VLA-0 state feature shape must match action_dim")
+        if self.output_features[ACTION].shape != (self.action_dim,):
+            raise ValueError("VLA-0 action feature shape must match action_dim")
