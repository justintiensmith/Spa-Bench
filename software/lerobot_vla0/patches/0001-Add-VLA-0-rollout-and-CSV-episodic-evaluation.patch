+class _FakeResponse:
+    def __init__(self, payload=None):
+        self._payload = payload
+
+    def raise_for_status(self) -> None:
+        return None
+
+    def json(self):
+        return self._payload
+
+
+class _FakeSession:
+    def __init__(self, actions: list[list[float]]):
+        self.actions = actions
+        self.get_calls = []
+        self.post_calls = []
+
+    def get(self, url, *, timeout):
+        self.get_calls.append((url, timeout))
+        return _FakeResponse({"status": "ok"})
+
+    def post(self, url, *, json, timeout):
+        self.post_calls.append((url, json, timeout))
+        return _FakeResponse(self.actions)
+
+
+def _decode_image(encoded: str) -> np.ndarray:
+    return np.load(io.BytesIO(base64.b64decode(encoded)), allow_pickle=False)
+
+
+def test_vla0_factory_registration_and_defaults():
+    config = make_policy_config("vla0", check_server_on_load=False)
+
+    assert isinstance(config, VLA0Config)
+    assert get_policy_class("vla0") is VLA0Policy
+    assert config.device == "cpu"
+    assert list(config.image_features) == [
+        "observation.images.wrist",
+        "observation.images.middle",
+    ]
+    assert config.action_feature.shape == (6,)
+
+
+def test_vla0_policy_serializes_observation_and_caches_actions():
+    actions = np.arange(24, dtype=np.float32).reshape(4, 6).tolist()
+    session = _FakeSession(actions)
+    config = VLA0Config(check_server_on_load=True, n_action_steps=2)
+    policy = VLA0Policy(config, session=session)
+    batch = {
+        "observation.images.wrist": torch.ones(1, 3, 2, 3),
+        "observation.images.middle": torch.zeros(1, 3, 2, 3),
+        OBS_STATE: torch.arange(6, dtype=torch.float32).unsqueeze(0),
+        "task": ["pick up the ball"],
+    }
+
+    first = policy.select_action(batch)
+    second = policy.select_action(batch)
+    third = policy.select_action(batch)
+
+    assert session.get_calls == [("http://127.0.0.1:10000/health", 5.0)]
+    assert len(session.post_calls) == 2
+    url, payload, timeout = session.post_calls[0]
+    assert url == "http://127.0.0.1:10000/predict_base64"
+    assert timeout == 300.0
+    assert payload["state"] == pytest.approx([0, 1, 2, 3, 4, 5])
+    assert payload["instr"] == "pick up the ball"
+    assert np.all(_decode_image(payload["base64_rgb"][0]) == 255)
+    assert np.all(_decode_image(payload["base64_rgb"][1]) == 0)
+    torch.testing.assert_close(first, torch.tensor(actions[0]).unsqueeze(0))
+    torch.testing.assert_close(second, torch.tensor(actions[1]).unsqueeze(0))
+    torch.testing.assert_close(third, torch.tensor(actions[0]).unsqueeze(0))
+
+
+def test_vla0_processors_keep_server_inputs_unnormalized_on_cpu():
+    config = VLA0Config(check_server_on_load=False)
+    # VLA-0 has no local processor artifacts even when its adapter config was
+    # loaded from a path; processing belongs to the remote service.
+    preprocessor, postprocessor = make_pre_post_processors(config, pretrained_path="unused")
+    batch = {
+        "observation.images.wrist": torch.zeros(3, 2, 2),
+        "observation.images.middle": torch.ones(3, 2, 2),
+        OBS_STATE: torch.arange(6, dtype=torch.float64),
+        "task": "move the block",
+    }
+
+    processed = preprocessor(batch)
+    action = postprocessor(torch.arange(6, dtype=torch.float64).unsqueeze(0))
+
+    assert processed["observation.images.wrist"].shape == (1, 3, 2, 2)
+    assert processed[OBS_STATE].shape == (1, 6)
+    assert processed[OBS_STATE].dtype == torch.float32
+    assert processed["task"] == ["move the block"]
+    assert action.device.type == "cpu"
+    assert action.dtype == torch.float32
+
+
+def test_vla0_runs_through_sync_rollout_inference_engine():
+    actions = np.arange(24, dtype=np.float32).reshape(4, 6).tolist()
+    session = _FakeSession(actions)
+    config = VLA0Config(check_server_on_load=False)
+    policy = VLA0Policy(config, session=session)
+    preprocessor, postprocessor = make_pre_post_processors(config)
+    engine = SyncInferenceEngine(
+        policy=policy,
+        preprocessor=preprocessor,
+        postprocessor=postprocessor,
+        dataset_features={ACTION: {"names": config.action_feature_names}},
+        ordered_action_keys=config.action_feature_names,
+        task="pick up the ball",
+        device="cpu",
+        robot_type="so_follower",
+    )
+    observation = {
+        "observation.images.wrist": np.full((2, 3, 3), 255, dtype=np.uint8),
+        "observation.images.middle": np.zeros((2, 3, 3), dtype=np.uint8),
+        OBS_STATE: np.arange(6, dtype=np.float32),
+    }
+
+    action = engine.get_action(observation)
+
+    torch.testing.assert_close(action, torch.tensor(actions[0]))
+    assert session.post_calls[0][1]["instr"] == "pick up the ball"
+
+
+def test_vla0_episodic_prompt_switch_clears_cached_action_chunk():
+    actions = np.arange(24, dtype=np.float32).reshape(4, 6).tolist()
+    session = _FakeSession(actions)
+    config = VLA0Config(check_server_on_load=False, n_action_steps=4)
+    policy = VLA0Policy(config, session=session)
+    preprocessor, postprocessor = make_pre_post_processors(config)
+    engine = SyncInferenceEngine(
+        policy=policy,
+        preprocessor=preprocessor,
+        postprocessor=postprocessor,
+        dataset_features={ACTION: {"names": config.action_feature_names}},
+        ordered_action_keys=config.action_feature_names,
+        task="first CSV prompt",
+        device="cpu",
+        robot_type="so_follower",
+    )
+    observation = {
+        "observation.images.wrist": np.full((2, 3, 3), 255, dtype=np.uint8),
+        "observation.images.middle": np.zeros((2, 3, 3), dtype=np.uint8),
+        OBS_STATE: np.arange(6, dtype=np.float32),
+    }
+
+    first_action = engine.get_action(observation)
+    second_action = engine.get_action(observation)
+    assert len(session.post_calls) == 1
+    assert session.post_calls[0][1]["instr"] == "first CSV prompt"
+    torch.testing.assert_close(first_action, torch.tensor(actions[0]))
+    torch.testing.assert_close(second_action, torch.tensor(actions[1]))
+
+    strategy = EpisodicStrategy(EpisodicStrategyConfig())
+    strategy._engine = engine
+    strategy._interpolator = MagicMock()
+    strategy._cached_obs_processed = {"stale": True}
+    strategy._prepare_episode_inference("second CSV prompt")
+
+    next_episode_action = engine.get_action(observation)
+    assert len(session.post_calls) == 2
+    assert session.post_calls[1][1]["instr"] == "second CSV prompt"
+    # Resetting at the episode boundary must discard the two actions that
+    # remained in VLA-0's previous four-action queue.
+    torch.testing.assert_close(next_episode_action, torch.tensor(actions[0]))
+    strategy._interpolator.reset.assert_called_once_with()
+    assert strategy._cached_obs_processed is None
+
