+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""LeRobot policy adapter for the VLA-0 deployment service."""
+
+from __future__ import annotations
+
+import base64
+import io
+from collections import deque
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import requests
+import torch
+from torch import Tensor
+
+from lerobot.configs import PreTrainedConfig
+from lerobot.policies.pretrained import PreTrainedPolicy
+from lerobot.utils.constants import OBS_STATE
+
+from .configuration_vla0 import VLA0Config
+
+
+class VLA0Policy(PreTrainedPolicy):
+    """Send LeRobot observations to a VLA-0 server and cache its action chunks."""
+
+    config_class = VLA0Config
+    name = "vla0"
+
+    def __init__(
+        self,
+        config: VLA0Config,
+        *,
+        session: requests.Session | None = None,
+        **_: Any,
+    ) -> None:
+        super().__init__(config)
+        config.validate_features()
+        self.config = config
+        self._session = session or requests.Session()
+        self._action_queue: deque[Tensor] = deque()
+        if config.check_server_on_load:
+            self._check_server()
+
+    @classmethod
+    def from_pretrained(
+        cls,
+        pretrained_name_or_path: str | Path | None = None,
+        *,
+        config: PreTrainedConfig | None = None,
+        revision: str | None = None,
+        session: requests.Session | None = None,
+        **kwargs: Any,
+    ) -> VLA0Policy:
+        """Instantiate the adapter; VLA-0 weights live in the remote service."""
+        del kwargs
+        if config is None:
+            if pretrained_name_or_path is None:
+                config = VLA0Config()
+            else:
+                config = VLA0Config.from_pretrained(pretrained_name_or_path, revision=revision)
+        if not isinstance(config, VLA0Config):
+            raise TypeError(f"VLA0Policy requires VLA0Config, got {type(config).__name__}")
+        policy = cls(config, session=session)
+        policy.eval()
+        return policy
+
+    def _check_server(self) -> None:
+        url = f"{self.config.server_url}{self.config.health_endpoint}"
+        try:
+            response = self._session.get(url, timeout=self.config.healthcheck_timeout_s)
+            response.raise_for_status()
+        except requests.RequestException as exc:
+            raise RuntimeError(
+                f"VLA-0 inference server is unavailable at {url}. Start rv_train/deploy/service.py first."
+            ) from exc
+
+    def get_optim_params(self) -> list[Tensor]:
+        return []
+
+    def reset(self) -> None:
+        self._action_queue.clear()
+
+    def forward(self, batch: dict[str, Tensor]) -> tuple[Tensor, dict | None]:
+        del batch
+        raise NotImplementedError("VLA-0's LeRobot adapter is inference-only")
+
+    @torch.no_grad()
+    def predict_action_chunk(self, batch: dict[str, Tensor], **_: Any) -> Tensor:
+        payload = {
+            "base64_rgb": [
+                self._encode_image(self._require_tensor(batch, camera_key))
+                for camera_key in self.config.camera_keys
+            ],
+            "state": self._state_as_list(self._require_tensor(batch, OBS_STATE)),
+            "instr": self._task_from_batch(batch),
+        }
+        url = f"{self.config.server_url}{self.config.predict_endpoint}"
+        try:
+            response = self._session.post(url, json=payload, timeout=self.config.request_timeout_s)
+            response.raise_for_status()
+            actions = np.asarray(response.json(), dtype=np.float32)
+        except (requests.RequestException, TypeError, ValueError) as exc:
+            raise RuntimeError(f"VLA-0 inference request failed at {url}") from exc
+
+        if actions.ndim != 2 or actions.shape[0] == 0 or actions.shape[1] != self.config.action_dim:
+            raise ValueError(
+                "VLA-0 server returned an invalid action chunk: expected "
+                f"[horizon, {self.config.action_dim}], got {tuple(actions.shape)}"
+            )
+        if not np.isfinite(actions).all():
+            raise ValueError("VLA-0 server returned non-finite actions")
+        return torch.from_numpy(actions).unsqueeze(0)
+
+    @torch.no_grad()
+    def select_action(self, batch: dict[str, Tensor], **kwargs: Any) -> Tensor:
+        if not self._action_queue:
+            actions = self.predict_action_chunk(batch, **kwargs)
+            steps = min(self.config.n_action_steps, actions.shape[1])
+            self._action_queue.extend(actions[:, :steps].transpose(0, 1))
+        return self._action_queue.popleft()
+
+    @staticmethod
+    def _require_tensor(batch: dict[str, Any], key: str) -> Tensor:
+        value = batch.get(key)
+        if not isinstance(value, Tensor):
+            raise KeyError(f"VLA-0 inference requires tensor feature {key!r}")
+        return value
+
+    @staticmethod
+    def _encode_image(image: Tensor) -> str:
+        image = image.detach().cpu()
+        if image.ndim == 4:
+            if image.shape[0] != 1:
+                raise ValueError(f"VLA-0 rollout supports batch size 1, got image shape {tuple(image.shape)}")
+            image = image[0]
+        if image.ndim != 3 or image.shape[0] not in (1, 3, 4):
+            raise ValueError(f"VLA-0 expected a CHW image tensor, got shape {tuple(image.shape)}")
+
+        image_np = image.permute(1, 2, 0).numpy()
+        if np.issubdtype(image_np.dtype, np.floating):
+            minimum = float(image_np.min())
+            maximum = float(image_np.max())
+            if minimum < 0 or maximum > 255:
+                raise ValueError(
+                    f"VLA-0 image values must be in [0, 1] or [0, 255], got [{minimum}, {maximum}]"
+                )
+            if maximum <= 1.0:
+                image_np = image_np * 255.0
+        image_np = np.clip(np.rint(image_np), 0, 255).astype(np.uint8)
+
+        buffer = io.BytesIO()
+        np.save(buffer, image_np, allow_pickle=False)
+        return base64.b64encode(buffer.getvalue()).decode("ascii")
+
+    def _state_as_list(self, state: Tensor) -> list[float]:
+        state = state.detach().cpu()
+        if state.ndim == 2:
+            if state.shape[0] != 1:
+                raise ValueError(f"VLA-0 rollout supports batch size 1, got state shape {tuple(state.shape)}")
+            state = state[0]
+        if state.ndim != 1 or state.shape[0] != self.config.action_dim:
+            raise ValueError(
+                f"VLA-0 expected state shape [{self.config.action_dim}], got {tuple(state.shape)}"
+            )
+        return state.to(dtype=torch.float32).tolist()
+
+    @staticmethod
+    def _task_from_batch(batch: dict[str, Any]) -> str | None:
+        task = batch.get("task")
+        if isinstance(task, (list, tuple)):
+            task = task[0] if task else None
+        if task is None:
+            return None
+        if not isinstance(task, str):
+            raise TypeError(f"VLA-0 task must be a string, got {type(task).__name__}")
+        return task
